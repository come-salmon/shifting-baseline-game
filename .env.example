# Copy to .env.local (local dev) AND add the same names in Vercel > Settings > Environment Variables
# (all environments), then REDEPLOY: Vite inlines VITE_* at build time.
# Raw values only: no quotes, no trailing spaces.

# Optional: "firebase" | "local". Default: firebase in production builds (or when DATABASE_URL is set), local in dev otherwise.
VITE_SYNC_BACKEND=firebase

# Required
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional (not used by Realtime Database)
VITE_FIREBASE_AUTH_DOMAIN=

